# Copy this file to `.env` and adjust as needed. `.env` is git-ignored.

# Connection string for PostgreSQL. Matches docker-compose.yml.
DATABASE_URL=postgres://readiness:readiness@localhost:5432/readiness

# HTTP Basic Auth for /admin. Leave ADMIN_PASSWORD empty to disable the
# login prompt (convenient locally, never do this in a deployed environment).
ADMIN_USER=admin
ADMIN_PASSWORD=admin
